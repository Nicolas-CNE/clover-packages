NAME=e2fsprogs
VERSION=1.47.0
URL=https://mirrors.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v1.47.0/e2fsprogs-1.47.0.tar.gz
SOURCE_TYPE=autotools
DEPS=util-linux
BUILD_STEPS=./configure --prefix=/usr --sysconfdir=/etc --enable-elf-shlibs && make -j$(nproc) && make DESTDIR=$DESTDIR install install-libs
