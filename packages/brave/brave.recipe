NAME="brave"
VERSION="1.64.113"
URL="https://github.com/brave/brave-browser/archive/refs/tags/v1.64.113.tar.gz"
DESCRIPTION="Brave Web Browser"
DEPENDENCIES="gtk3 nss"
BUILD_STEPS="mkdir -p "$DESTDIR/usr/bin"
if [ -f Makefile ]; then
    make PREFIX="$DESTDIR/usr" install || make DESTDIR="$DESTDIR" install
else
    cp -f brave "$DESTDIR/usr/bin/" 2>/dev/null || true
fi"
